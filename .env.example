# Учётки для сценария idor-books (роли берут их через ${env.*}).
# Секреты держим в окружении/CI-secrets, а не в YAML сценария.
# Значения ниже — сид-пользователи VAmPI после GET /createdb.
#
#   export $(grep -v '^#' .env.example | xargs)   # подгрузить в текущую сессию

TARGET_URL=http://localhost:5001

USER_A_NAME=name1
USER_A_PASS=pass1
USER_B_NAME=name2
USER_B_PASS=pass2
